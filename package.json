    "eslint-plugin-storybook": "^10.6.0",
    "lefthook": "^2.1.12",
    "lint-staged": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
